+/* Theora cutscenes: theoraplayer's frame upload (0x00a818a0) writes every decoded
+ * frame with glTexSubImage2D(GL_RGB, GL_UNSIGNED_BYTE) into a texture the engine
+ * made GL_RGBA. Desktop GL converts; GLES 3 (and WebGL 2) refuse a format that
+ * differs from the level's (GL_INVALID_OPERATION), so every video stayed black
+ * while its Vorbis track played. Each 2D texture's level-0 format is remembered
+ * and RGB rows going into an RGBA level are widened (alpha 255, what desktop GL
+ * fills in). The unpack alignment is the default 4: the engine never changes it. */
+#define TEXFMT_NAMES 65536u
+static uint8_t g_texfmt[TEXFMT_NAMES];      /* 0 unknown or other, 3 GL_RGB, 4 GL_RGBA */
+static uint8_t *g_widen_buf;
+static size_t g_widen_cap;
+static uint32_t g_tex_widened;
+static void texfmt_note(uint32_t name, uint32_t ifmt, uint32_t format, uint32_t type) {
+    if (!name || name >= TEXFMT_NAMES) return;
+    g_texfmt[name] = type != GL_UNSIGNED_BYTE ? 0u :
+                     (ifmt == GL_RGBA && format == GL_RGBA) ? 4u : (ifmt == GL_RGB && format == GL_RGB) ? 3u : 0u;
+}
+/* RGB pixels for an RGBA level, widened into a scratch buffer; NULL to pass the
+ * call through unchanged */
+static const uint8_t *texfmt_widen(uint32_t name, uint32_t w, uint32_t h, const uint8_t *px) {
+    if (!px || !name || name >= TEXFMT_NAMES || g_texfmt[name] != 4u || !w || !h || w > 16384u || h > 16384u)
+        return NULL;
+    size_t need = (size_t)w * h * 4u;
+    if (need > g_widen_cap) {
+        uint8_t *n = realloc(g_widen_buf, need);
+        if (!n) return NULL;
+        g_widen_buf = n; g_widen_cap = need;
+    }
+    size_t src_row = ((size_t)w * 3u + 3u) & ~(size_t)3u;
+    for (uint32_t y = 0; y < h; ++y) {
+        const uint8_t *s = px + (size_t)y * src_row;
+        uint8_t *d = g_widen_buf + (size_t)y * w * 4u;
+        for (uint32_t x = 0; x < w; ++x, s += 3, d += 4) { d[0] = s[0]; d[1] = s[1]; d[2] = s[2]; d[3] = 0xFFu; }
+    }
+    if (++g_tex_widened == 1u)
+        isaac_log("[isaac][gl] texture %u: RGB %ux%u into its RGBA level, widened to RGBA (GLES refuses the mismatch)", name, w, h);
+    return g_widen_buf;
+}
 

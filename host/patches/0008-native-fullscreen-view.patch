+#ifdef ISAAC_NATIVE
+/* Native: the game's window (GLFW's "GLFW30" class) is the drawing surface,
+ * which has no frame and a fixed size (native_gl.c's SURFACE_W/H). The
+ * engine takes its point scale from the window's client size (0x969a10:
+ * floor(min(h/240, w/400)), 480x270 points at 960x540), so the size it is
+ * given decides how much of the room fits on screen.
+ *
+ * Windowed, that is always the surface. Full screen (Options -> Fullscreen,
+ * or Fullscreen=1 in options.ini) GLFW sizes the window to the monitor, the
+ * display below; ISAAC_NATIVE_FULLSCREEN_VIEW=<w>x<h> answers that with a
+ * smaller window instead, which the engine fills with fewer points: the
+ * zoomed view of the console releases (852x480: 426x240 points). Below
+ * 480 rows or 800 columns the scale drops to 1 and the view zooms out, so
+ * the size is clamped. Unset, full screen keeps the surface's size. */
+#define NATIVE_SURFACE_W 960
+#define NATIVE_SURFACE_H 540
+static int g_fs_w, g_fs_h, g_fs_read;
+static int win_is_game(const char *cls) {
+    return cls && strncmp(cls, "GLFW3", 5) == 0 && !strstr(cls, "Helper");
+}
+static void native_window_size(uint32_t *w, uint32_t *h) {
+    if (!g_fs_read) {
+        g_fs_read = 1;
+        const char *e = getenv("ISAAC_NATIVE_FULLSCREEN_VIEW");
+        int fw = 0, fh = 0;
+        if (e && sscanf(e, "%dx%d", &fw, &fh) == 2) {
+            if (fw > NATIVE_SURFACE_W) fw = NATIVE_SURFACE_W;
+            if (fh > NATIVE_SURFACE_H) fh = NATIVE_SURFACE_H;
+            if (fw < 800) fw = 800;
+            if (fh < 480) fh = 480;
+            g_fs_w = fw;
+            g_fs_h = fh;
+            isaac_log("[isaac][ui] full screen is a %dx%d window", fw, fh);
+        }
+    }
+    /* The engine's borderless full screen asks for one column more than
+     * the display (1281x720), so a size that covers it counts. */
+    if (*w >= DISPLAY_W && *h >= DISPLAY_H && g_fs_w) {
+        *w = (uint32_t)g_fs_w;
+        *h = (uint32_t)g_fs_h;
+        return;
+    }
+    *w = NATIVE_SURFACE_W;
+    *h = NATIVE_SURFACE_H;
+}
+/* The game window's client size: what the engine draws into, from the
+ * bottom-left corner of the surface. */
+void isaac_native_view_size(int *w, int *h) {
+    *w = NATIVE_SURFACE_W;
+    *h = NATIVE_SURFACE_H;
+    for (int i = 0; i < g_win_n; ++i)
+        if (g_win[i].cls >= 0 && win_is_game(g_wc[g_win[i].cls].name)) {
+            *w = (int)g_win[i].w;
+            *h = (int)g_win[i].h;
+        }
+}
+#endif
+

+/* The native host (host): the same rule on the monotonic
+ * clock. There the present waits for the display (vsync), so a pass that
+ * misses 16.7 ms waits for the next vblank and the game runs at half speed
+ * until the load drops. ISAAC_RENDER_GATE=0 draws every frame (the default),
+ * 1 is the rule above, 4 skips every in-between frame (30 fps: the game holds
+ * its speed while one update and one render fit in a tick). The Switch's play
+ * mode sets it from settings.ini. A skipped frame waits for the next tick only
+ * on the wall clock: on the deterministic one (the tests, the benchmarks) the
+ * game's time is the queries', and a sleep would only be idle time.
+ * With vsync on the Switch the display paces the passes instead
+ * (native_gl.c: one vblank per pass, a skipped render takes its vblank
+ * without a frame): no sleeps, and the native side decides the in-between
+ * frame with hysteresis; the rule here still keeps its counts. */
+int isaac_native_slot_paced(void) __attribute__((weak));
+int isaac_native_skip_slot(void) __attribute__((weak));
+void isaac_native_pace_render(void) __attribute__((weak));
+int isaac_native_pace_decide(int rule_skip) __attribute__((weak));
+static int native_paced(void) { return isaac_native_slot_paced && isaac_native_slot_paced(); }
+static int g_rg_mode = -1, g_rg_wall;
+static int native_gate_mode(void) {
+    if (g_rg_mode < 0) {
+        const char *e = getenv("ISAAC_RENDER_GATE");
+        g_rg_mode = (e && (*e == '1' || *e == '4')) ? *e - '0' : 0;
+        const char *w = getenv("ISAAC_NATIVE_WALL_CLOCK");
+        if (!w) w = getenv("ISAAC_NATIVE_WINDOW");
+        g_rg_wall = w && *w == '1';
+        if (g_rg_mode)
+            isaac_log("[isaac][frame] ISAAC_RENDER_GATE=%d: %s, %s", g_rg_mode,
+                      g_rg_mode == 4 ? "every in-between frame skipped" : "an in-between frame skipped when it would make the next tick late",
+                      g_rg_wall ? "paced on the wall clock" : "not paced (deterministic clock)");
+    }
+    return g_rg_mode;
+}
+int isaac_render_gate(void) {
+    int mode = native_gate_mode();
+    if (!mode) return 0;
+    uint32_t game = isaac_r32(0x00c71678u);
+    int have = game && isaac_is_guest_va(game + 0x264fbu);
+    double now = emscripten_get_now();
+    int paced = native_paced();
+    if (paced) isaac_native_pace_render();
+    uint32_t decided = g_rg_drawn + g_rg_skipped;
+    int skip = isaac_render_gate_decide(now, have, have ? isaac_r32(game + 0x264f8u) : 0u);
+    if (paced && mode == 1 && g_rg_drawn + g_rg_skipped != decided) {   /* the pass after a tick */
+        int want = isaac_native_pace_decide(skip);
+        if (want && !skip) { --g_rg_drawn; ++g_rg_skipped; g_rg_cls = 2; g_rg_draw_at = 0.0; }
+        else if (!want && skip) { --g_rg_skipped; ++g_rg_drawn; g_rg_cls = 1; g_rg_draw_at = now; }
+        g_rg_pace_pending = 0;
+        g_rg_wait = 0.0;
+        skip = want;
+    }
+    if (mode == 4 && !skip && g_rg_cls == 1) {      /* the rule would draw this in-between frame */
+        --g_rg_drawn; ++g_rg_skipped; g_rg_cls = 2;
+        g_rg_pace_pending = 0;
+        g_rg_draw_at = 0.0;
+        g_rg_wait = g_rg_pace_at > now ? g_rg_pace_at - now : 0.0;
+        skip = 1;
+    }
+    if (skip && (g_rg_skipped == 1u || g_rg_skipped % 1800u == 0u))
